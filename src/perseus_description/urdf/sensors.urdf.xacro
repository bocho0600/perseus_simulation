<?xml version="1.0"?>
<robot name="lidar" xmlns:xacro="http://ros.org/wiki/xacro">

<!--
  Gazebo sensors for the Livox MID-360. The livox_frame link itself is declared in
  sensor_mount.urdf.xacro, next to the mast it is mounted on; these blocks only attach
  simulated hardware to it by name.
-->

<!-- Simulating the Livox MID-360 -->
<gazebo reference="${prefix}livox_frame">
  <material>
    <ambient>0.1 0.1 0.1 1</ambient>
    <diffuse>0.1 0.1 0.1 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
  </material>
  <sensor name="${prefix}lidar_sensor" type="gpu_lidar">
    <topic>scan_3d_dense</topic>
    <!-- Not the cloud the stack sees. gpu_lidar can only render a regular grid, and the
         real MID-360 scans a non-repetitive rosette that fills its field of view over
         several frames. This grid is the dense depth source that
         perseus_description/scripts/livox_pattern_sampler.py samples along the real
         MID-360 beam directions (UnitySensors' Mid-360 scan pattern), 20,000 points a
         frame, to publish /livox/lidar. Rays are 0.25 deg x 0.33 deg, so every pattern
         direction lands within half a cell of a rendered ray.
         The sampler's h_samples, v_samples and angle limits must match this block. -->
    <update_rate>10</update_rate>
    <always_on>false</always_on>
    <visualize>false</visualize>
    <ray>
      <scan>
        <horizontal>
          <samples>1440</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
        <!-- Angle Simulating the Livox MID-360 -->
        <vertical>
          <samples>192</samples>
          <min_angle>-0.13</min_angle>       <!-- -7.45 deg: MID-360 floor is -7.2 -->
          <max_angle>0.915</max_angle>       <!-- +52.4 deg: MID-360 ceiling is +52.2 -->
        </vertical>
      </scan>
      <range>
        <!-- 0.1 m close-proximity blind zone; 40 m @ 10% reflectivity
             (70 m @ 80%, but 40 m is the figure to plan coverage against) -->
        <min>0.1</min>
        <max>40.0</max>
        <resolution>0.013</resolution>
      </range>
      <!--
        0x0FFFFFFE: everything except bit 0, which lunabotics_zones uses for
        its GUI-only zone outlines. Without this the sensor ranges against
        those annotation visuals - they have no collision, but gz sensors see
        rendered geometry, not collision geometry.
      -->
      <visibility_mask>268435454</visibility_mask>
    </ray>
    <gz_frame_id>${prefix}livox_frame</gz_frame_id>
  </sensor>
</gazebo>


<!--
  The IMU is attached to livox_imu_frame, not to livox_frame: it lives 4.4 cm inside the
  housing from the LiDAR origin, and sensor_mount.urdf.xacro now says so. Attaching it here
  is what makes that offset real in simulation rather than just present in TF, so anything
  that reads the LiDAR-IMU extrinsic out of the description gets the same answer in Gazebo
  as on the robot.
-->
<gazebo reference="${prefix}livox_imu_frame">
    <material>Gazebo/Grey</material>
    <sensor name="${prefix}lidar_imu" type="imu">
        <always_on>1</always_on>
        <!-- the MID-360's built-in ICM40609 pushes IMU at 200 Hz by default;
             FAST-LIO needs that rate to de-skew and propagate between scans -->
        <update_rate>200</update_rate>
        <visualize>true</visualize>
        <topic>/scan_3d/imu</topic>
        <!-- Add frame id to imu sensor (achieving correct frame association)-->
        <gz_frame_id>${prefix}livox_imu_frame</gz_frame_id>
    </sensor>
</gazebo>


</robot>
