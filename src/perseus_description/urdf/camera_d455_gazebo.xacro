<?xml version="1.0"?>
<!--
  Gazebo sensors for the RealSense D455.

  All four are always_on false, so gz renders them only while something is
  subscribed - the same pattern the Livox uses in sensors.urdf.xacro. That
  matters a lot here: with the four sensors rendering unconditionally at 30 Hz,
  the whole simulation dropped to RTF 0.395 and the Livox fell from 9.8 Hz to
  3.87 Hz. Rendering is the dominant cost in this world, and only the colour
  stream has a consumer (vision/aruco_detector, and cube_detector for aligned
  depth), so paying for infra1/infra2 continuously is pure waste.

  update_rate is 15 rather than 30 for the same reason. Fiducial acquisition
  happens while the robot is stationary or turning slowly, so 15 Hz is ample.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="camera_d455_gazebo" params="name:=camera">

    <!--
      Plain colour camera, not an rgbd_camera. It was rgbd, which renders a
      depth pass and a point cloud alongside the image; nothing in the
      Lunabotics stack wants either. vision/aruco_detector reads only the colour
      image and its camera_info.

      Consequence worth knowing: this removes
      /camera/camera/aligned_depth_to_color/image_raw, which was the rgbd
      sensor's depth output and is what cube_detector uses in its
      depth_estimation_mode "depth_image". cube_detector is not launched by
      localisation or navigation and there are no cubes in Lunabotics, but if
      you do run vision.launch.py against this sim, set depth_estimation_mode
      to "none" or switch this sensor back to rgbd_camera.

      Topic naming, confirmed against a running sim rather than assumed. A
      camera sensor publishes the image at <topic> and its info at the SIBLING
      path - the last element replaced by camera_info - which is the same shape
      the infra1/infra2 cameras already use. So <topic> is
      /camera/camera/color/image and the info lands on
      /camera/camera/color/camera_info, both unchanged from what rgbd produced.
      The bridge entries did not need to move.
    -->
    <gazebo reference="${name}_color_frame">
      <sensor name="color_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <always_on>false</always_on>
        <camera>
          <horizontal_fov>1.089</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
          <!--
            0x0FFFFFFE: everything except bit 0, which lunabotics_zones uses for
            its GUI-only zone outlines. Without this the sensor ranges against
            those annotation visuals - they have no collision, but gz sensors see
            rendered geometry, not collision geometry.
          -->
          <visibility_mask>268435454</visibility_mask>
        </camera>
        <topic>/${name}/${name}/color/image</topic>
        <gz_frame_id>${name}_color_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>

    <!--
      Standalone depth camera: REMOVED, not commented out.

      It published /camera/camera/depth (bridged to depth/image_rect_raw,
      depth/camera_info and depth/color/points) and nothing subscribed to any of
      them, so it was rendering a second 640x480 depth pass for nobody. The depth
      cube_detector actually reads,
      /camera/camera/aligned_depth_to_color/image_raw, comes from the
      rgbd_camera above, which produces colour and depth from one sensor.

      Deleted rather than commented because the block contained its own XML
      comment explaining visibility_mask, and nested comments are not legal XML -
      commenting it out silently broke the whole xacro parse. Recover it from git
      history if you want the unaligned depth stream the real D455 driver also
      publishes; note it is aligned to camera_depth_frame rather than to colour,
      which is why cube_detector wants the aligned one.
    -->

    <!-- Left IR Camera -->
    <gazebo reference="${name}_infra1_frame">
      <sensor name="ir_left_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <always_on>false</always_on>
        <camera>
          <horizontal_fov>1.089</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <!--
            0x0FFFFFFE: everything except bit 0, which lunabotics_zones uses for
            its GUI-only zone outlines. Without this the sensor ranges against
            those annotation visuals - they have no collision, but gz sensors see
            rendered geometry, not collision geometry.
          -->
          <visibility_mask>268435454</visibility_mask>
        </camera>
        <topic>/${name}/${name}/infra1/image_raw</topic>
        <gz_frame_id>${name}_infra1_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>

    <!-- Right IR Camera -->
    <gazebo reference="${name}_infra2_frame">
      <sensor name="ir_right_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <always_on>false</always_on>
        <camera>
          <horizontal_fov>1.089</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <!--
            0x0FFFFFFE: everything except bit 0, which lunabotics_zones uses for
            its GUI-only zone outlines. Without this the sensor ranges against
            those annotation visuals - they have no collision, but gz sensors see
            rendered geometry, not collision geometry.
          -->
          <visibility_mask>268435454</visibility_mask>
        </camera>
        <topic>/${name}/${name}/infra2/image_raw</topic>
        <gz_frame_id>${name}_infra2_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
