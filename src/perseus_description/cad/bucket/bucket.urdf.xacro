          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file://$(find perseus_description)/meshes/bucket/Frame_Repaired_1.stl"/>
          </geometry>
          <material name="${prefix}Frame_Repaired_1_material">
            <color rgba="0 1 1 1"/>
          </material>
        </visual>
        <collision name="Frame_Repaired_1_collision">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="file://$(find perseus_description)/meshes/bucket/Frame_Repaired_1.stl"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="8"/>
          <origin xyz="-0.00259372 0.25570765 0.03804597" rpy="0 0 0"/>
          <xacro:box_inertia m="8" x="0.2" y="0.2" z="0.2"/>
        </inertial>
      </link>
