<?xml version="1.0"?>
<!--
  bucket_loops.urdf.xacro  -  AUTOGENERATED.

  URDF is a tree and cannot express the closed loops in this linkage. These
  joints were removed from the tree; Gazebo re-applies them here as raw SDF.
  The <gazebo> element is passed through untouched by the URDF->SDF converter.

  IMPORTANT: loop closures need `preserveFixedJoint` behaviour on the links
  they touch, otherwise the SDF converter may weld those links away before
  these joints are applied. Verify with:
      gz sdf -p robot.urdf | grep -A5 _loop
-->
<robot name="bucket_loops" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="bucket_loops" params="prefix:=^|''">
    <gazebo>
      <!-- loop closure: Bucket_1
                        -> Left_Arm_-_Square_Tube_1 -->
      <joint name="${prefix}Revolute_3_loop" type="revolute">
        <parent>${prefix}Bucket_1</parent>
        <child>${prefix}Left_Arm_Square_Tube_1</child>
        <pose>0 0 0.202 3.1415927 0 1.5707963</pose>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit><lower>-3.1416</lower><upper>3.1416</upper></limit>
          <dynamics><damping>0.1</damping></dynamics>
        </axis>
      </joint>

      <!-- loop closure: 250mm_Actuator_1_piston
                        -> Actuator_Bracket_2 -->
      <joint name="${prefix}Revolute_4_loop" type="revolute">
        <parent>${prefix}a250mm_Actuator_1_piston</parent>
        <child>${prefix}Actuator_Bracket_2</child>
        <pose>0 0.365 0.00092597 0 0 0</pose>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit><lower>-3.1416</lower><upper>3.1416</upper></limit>
          <dynamics><damping>0.1</damping></dynamics>
        </axis>
      </joint>

      <!-- loop closure: 250mm_Actuator_2_piston
                        -> Actuator_Bracket_1 -->
      <joint name="${prefix}Revolute_6_loop" type="revolute">
        <parent>${prefix}a250mm_Actuator_2_piston</parent>
        <child>${prefix}Actuator_Bracket_1</child>
        <pose>0 -0.365 0.00092597 3.1415927 0 0</pose>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit><lower>-3.1416</lower><upper>3.1416</upper></limit>
          <dynamics><damping>0.1</damping></dynamics>
        </axis>
      </joint>

      <!-- loop closure: 250mm_Actuator_3_piston
                        -> Actuator_Bracket_4 -->
      <joint name="${prefix}Revolute_8_loop" type="revolute">
        <parent>${prefix}a250mm_Actuator_3_piston</parent>
        <child>${prefix}Actuator_Bracket_4</child>
        <pose>0 -0.365 -0.02025 0 0 1.5707963</pose>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit><lower>-3.1416</lower><upper>3.1416</upper></limit>
          <dynamics><damping>0.1</damping></dynamics>
        </axis>
      </joint>
    </gazebo>
  </xacro:macro>
</robot>
