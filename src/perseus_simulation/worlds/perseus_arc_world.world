<?xml version="1.0"?>
<!--
  Perseus simulation world laid out as the UCF Exolith Lab arena used for the
  2026 NASA International Lunabotics Championship (guidebook v1, Aug 2026).

  World frame == guidebook Origin Point frame:
    origin = centre of the front (south) arena wall, at grade
    +X     = east, +Y = north (into the arena)

    regolith bed       X -4.57 .. 4.57, Y 0.00 .. 8.10   (9.14 m x 8.10 m)
    excavation zone    Y 0.00 .. 3.00   (includes the starting zone)
    obstacle zone      Y 3.00 .. 8.10
    starting zone      X -2.25 .. 0.00, Y 0.00 .. 2.25
    construction zone  X  2.52 .. 4.57, Y 4.69 .. 8.10
    target berm area   X  3.11 .. 4.01, Y 5.30 .. 7.50, centre (3.56, 6.40)
    judge platform     Y 8.10 .. 9.10

  Guidebook coordinates therefore drop straight into this world - e.g. the berm
  target centre is nav goal (3.56, 6.40).
-->
<sdf version="1.8">
  <world name="perseus_arc_world">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <!-- Diggable regolith (perseus_simulation src/regolith_dig.cpp): the bucket
         cuts the bed, carries the load and dumps it into berms; the bed is
         rebuilt as it changes. Defaults match Moon_DEM and the bucket model. -->
    <plugin
      filename="RegolithDig"
      name="perseus_simulation::RegolithDig">
    </plugin>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 4 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!--
      These have to live inside <scene>. As direct children of <world> they are
      not valid SDF, gz warns "XML Element[ambient] ... not defined in SDF" and
      drops them, which left the scene with no ambient light at all - the
      regolith rendered nearly black however bright its texture was.
    -->
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.80 0.82 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Regolith bin walls, judge platform and 80/20 fiducial rail -->
    <include>
      <uri>model://perseus_arc_world</uri>
    </include>

    <!-- Visual-only excavation / obstacle / starting / construction / berm outlines -->
    <include>
      <uri>model://lunabotics_zones</uri>
    </include>

    <!-- Regolith surface (squeezed DEM) -->
    <include>
      <uri>model://Moon_DEM</uri>
    </include>

    <!-- Team-supplied ArUco markers on the 80/20 fiducial rail (sections 4.6.7, 5.7).
         Sensor-visible on purpose: the camera has to detect these. -->
    <include>
      <uri>model://lunabotics_fiducials</uri>
    </include>

    <!--
      Boulder obstacles, guidebook section 3.1: 30-40 cm, at least three on the
      obstacle zone surface. Each is its own top-level model rather than a link
      of one shared model, so it can be picked and dragged on its own in the
      Gazebo GUI (Translate tool, T) to re-roll the obstacle field - the real
      placement is randomised before every run. Static, so they never settle or
      get pushed; moving one in the GUI moves its collision too.

      The OpenRobotics "Falling Rock" meshes are metre-scale, so each is scaled
      into the 30-40 cm band (extents noted per boulder). Each Z is the terrain
      height measured at that XY (a probe body dropped onto the squeezed
      Moon_DEM) plus 0.2 * height, leaving the bottom 30% buried. A boulder
      dragged elsewhere keeps its Z, so on a slope it may float or sink a few cm;
      re-measure if that matters. These poses keep clear of the starting zone
      (X -2.25..0, Y 0..2.25) and the construction zone (X 2.52..4.57, Y 4.69..8.10).
    -->
    <!-- Falling Rock 4 scaled to 0.35 x 0.34 x 0.37 m; grade here is +0.039 m -->
    <model name='boulder_1'>
      <static>true</static>
      <pose>-2.95 4.3 0.113 0 0 1.36</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/meshes/FallingRock04_Collider.dae</uri>
              <scale>0.82 0.82 0.82</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/meshes/FallingRock04.dae</uri>
              <scale>0.82 0.82 0.82</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0</diffuse>
            <specular>1.0 1.0 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Albedo.jpg</albedo_map>
                <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Normal.jpg</normal_map>
                <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Roughness.jpg</roughness_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Falling Rock 2 scaled to 0.34 x 0.38 x 0.32 m; grade here is +0.006 m -->
    <model name='boulder_2'>
      <static>true</static>
      <pose>-0.55 5.6 0.07 0 0 -2.11</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/meshes/FallingRock02_Collider.dae</uri>
              <scale>0.38 0.38 0.38</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/meshes/FallingRock02.dae</uri>
              <scale>0.38 0.38 0.38</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0</diffuse>
            <specular>1.0 1.0 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Albedo.jpg</albedo_map>
                <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Normal.jpg</normal_map>
                <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Roughness.jpg</roughness_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Falling Rock 1 scaled to 0.36 x 0.36 x 0.33 m; grade here is -0.032 m -->
    <model name='boulder_3'>
      <static>true</static>
      <pose>1.7 3.95 0.035 0 0 0.44</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/meshes/FallingRock01_Collider.dae</uri>
              <scale>0.24 0.24 0.24</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/meshes/FallingRock01.dae</uri>
              <scale>0.24 0.24 0.24</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0</diffuse>
            <specular>1.0 1.0 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/materials/textures/FallingRocks_Albedo.jpg</albedo_map>
                <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/materials/textures/FallingRocks_Normal.jpg</normal_map>
                <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/materials/textures/FallingRocks_Roughness.jpg</roughness_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Falling Rock 4 scaled to 0.40 x 0.39 x 0.43 m; grade here is +0.025 m -->
    <model name='boulder_4'>
      <static>true</static>
      <pose>-3.55 6.95 0.11 0 0 -1.57</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/meshes/FallingRock04_Collider.dae</uri>
              <scale>0.94 0.94 0.94</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/meshes/FallingRock04.dae</uri>
              <scale>0.94 0.94 0.94</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0</diffuse>
            <specular>1.0 1.0 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Albedo.jpg</albedo_map>
                <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Normal.jpg</normal_map>
                <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Roughness.jpg</roughness_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Falling Rock 2 scaled to 0.30 x 0.34 x 0.29 m; grade here is -0.015 m -->
    <model name='boulder_5'>
      <static>true</static>
      <pose>0.85 7.15 0.042 0 0 2.62</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/meshes/FallingRock02_Collider.dae</uri>
              <scale>0.34 0.34 0.34</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/meshes/FallingRock02.dae</uri>
              <scale>0.34 0.34 0.34</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0</diffuse>
            <specular>1.0 1.0 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Albedo.jpg</albedo_map>
                <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Normal.jpg</normal_map>
                <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 2/6/files/materials/textures/FallingRocks_Roughness.jpg</roughness_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Falling Rock 1 scaled to 0.31 x 0.31 x 0.29 m; grade here is -0.033 m -->
    <model name='boulder_6'>
      <static>true</static>
      <pose>2.4 1.2 0.025 0 0 1.94</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/meshes/FallingRock01_Collider.dae</uri>
              <scale>0.21 0.21 0.21</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/meshes/FallingRock01.dae</uri>
              <scale>0.21 0.21 0.21</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0</diffuse>
            <specular>1.0 1.0 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/materials/textures/FallingRocks_Albedo.jpg</albedo_map>
                <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/materials/textures/FallingRocks_Normal.jpg</normal_map>
                <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 1/6/files/materials/textures/FallingRocks_Roughness.jpg</roughness_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Falling Rock 4 scaled to 0.37 x 0.36 x 0.40 m; grade here is +0.083 m -->
    <model name='boulder_7'>
      <static>true</static>
      <pose>-3.45 2.7 0.163 0 0 0.12</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/meshes/FallingRock04_Collider.dae</uri>
              <scale>0.88 0.88 0.88</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/meshes/FallingRock04.dae</uri>
              <scale>0.88 0.88 0.88</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0</diffuse>
            <specular>1.0 1.0 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Albedo.jpg</albedo_map>
                <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Normal.jpg</normal_map>
                <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/falling rock 4/9/files/materials/textures/FallingRocks_Roughness.jpg</roughness_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- The room around the bin: event tent, floor, team pit, mission control,
         judges and people outside the walls. Sensor-visible; see its header. -->
    <include>
      <uri>model://exolith_lab</uri>
    </include>

  </world>
</sdf>
