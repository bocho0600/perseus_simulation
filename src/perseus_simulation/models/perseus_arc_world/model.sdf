<?xml version='1.0'?>
<!--
  UCF Exolith Lab regolith bin, per Figure 2 "UCF Arena Layout" of the
  2026 NASA International Lunabotics Championship Guidebook (v1, Aug 2026).

  Coordinate frame matches the guidebook Origin Point:
    origin  = centre of the front (south) arena wall, at grade
    +X      = east  (to the right when looking into the arena)
    +Y      = north (into the arena, away from the front wall)

  Regolith bed interior: 9.14 m (X) x 8.10 m (Y), X in [-4.57, 4.57].
  A 1.00 m judge platform sits north of the bed, Y in [8.10, 9.10],
  giving the ~9.14 x 9.10 m overall arena the guidebook rounds to "~10 x 10 m".
-->
<sdf version='1.8'>
  <model name='lunabotics_arena'>
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>

    <!-- Front (south) wall: carries the 80/20 fiducial rail, Y = 0 -->
    <link name='Wall_S'>
      <pose>0 -0.075 0.25 0 0 0</pose>
      <collision name='Wall_S_Collision'>
        <geometry>
          <box>
            <size>9.44 0.15 0.5</size>
          </box>
        </geometry>
      </collision>
      <visual name='Wall_S_Visual'>
        <geometry>
          <box>
            <size>9.44 0.15 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.16 1</ambient>
          <diffuse>0.22 0.22 0.24 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- Rear (north) wall at the far edge of the regolith bed, Y = 8.10 -->
    <link name='Wall_N'>
      <pose>0 8.175 0.25 0 0 0</pose>
      <collision name='Wall_N_Collision'>
        <geometry>
          <box>
            <size>9.44 0.15 0.5</size>
          </box>
        </geometry>
      </collision>
      <visual name='Wall_N_Visual'>
        <geometry>
          <box>
            <size>9.44 0.15 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.16 1</ambient>
          <diffuse>0.22 0.22 0.24 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- West wall, X = -4.57 -->
    <link name='Wall_W'>
      <pose>-4.645 4.05 0.25 0 0 1.5708</pose>
      <collision name='Wall_W_Collision'>
        <geometry>
          <box>
            <size>8.10 0.15 0.5</size>
          </box>
        </geometry>
      </collision>
      <visual name='Wall_W_Visual'>
        <geometry>
          <box>
            <size>8.10 0.15 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.16 1</ambient>
          <diffuse>0.22 0.22 0.24 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- East wall, X = 4.57 (ingress side) -->
    <link name='Wall_E'>
      <pose>4.645 4.05 0.25 0 0 1.5708</pose>
      <collision name='Wall_E_Collision'>
        <geometry>
          <box>
            <size>8.10 0.15 0.5</size>
          </box>
        </geometry>
      </collision>
      <visual name='Wall_E_Visual'>
        <geometry>
          <box>
            <size>8.10 0.15 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.16 1</ambient>
          <diffuse>0.22 0.22 0.24 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- Judge platform: 1.00 m deep strip north of the regolith bed -->
    <link name='Judge_Platform'>
      <pose>0 8.60 0.25 0 0 0</pose>
      <collision name='Judge_Platform_Collision'>
        <geometry>
          <box>
            <size>9.44 1.00 0.5</size>
          </box>
        </geometry>
      </collision>
      <visual name='Judge_Platform_Visual'>
        <geometry>
          <box>
            <size>9.44 1.00 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.28 0.28 0.30 1</ambient>
          <diffuse>0.38 0.38 0.40 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!--
      80/20 fiducial rail: 1.5 m of 1" x 1" T-slot, matte black, mounted on the
      inside face of the front wall, 0.40 m above grade, near end 0.5 m west of
      the Origin Point (guidebook section 5.7 / Figure 4).
    -->
    <link name='Fiducial_Rail'>
      <pose>-1.25 0.0127 0.40 0 0 0</pose>
      <collision name='Fiducial_Rail_Collision'>
        <geometry>
          <box>
            <size>1.5 0.0254 0.0254</size>
          </box>
        </geometry>
      </collision>
      <visual name='Fiducial_Rail_Visual'>
        <geometry>
          <box>
            <size>1.5 0.0254 0.0254</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.0 0.0 0.0 1</specular>
        </material>
      </visual>
    </link>

    <!-- Fixed joints connecting the walls (leave the loop open) -->
    <joint name="joint_wall_s_w" type="fixed">
      <parent>Wall_S</parent>
      <child>Wall_W</child>
    </joint>

    <joint name="joint_wall_w_n" type="fixed">
      <parent>Wall_W</parent>
      <child>Wall_N</child>
    </joint>

    <joint name="joint_wall_n_e" type="fixed">
      <parent>Wall_N</parent>
      <child>Wall_E</child>
    </joint>

    <joint name="joint_wall_n_platform" type="fixed">
      <parent>Wall_N</parent>
      <child>Judge_Platform</child>
    </joint>

    <joint name="joint_wall_s_rail" type="fixed">
      <parent>Wall_S</parent>
      <child>Fiducial_Rail</child>
    </joint>

  </model>
</sdf>
