      <collision name='floor_w_collision'><geometry><box><size>6.280 9.250 0.100</size></box></geometry></collision>
      <visual name='floor_w_visual'><geometry><box><size>6.280 9.250 0.100</size></box></geometry>
        <material><ambient>0.42 0.42 0.40 1</ambient><diffuse>0.52 0.52 0.50 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    </link>
    <link name='floor_e'>
      <pose>7.8600 4.4750 -0.0500 0.0000 0.0000 0.0000</pose>
      <collision name='floor_e_collision'><geometry><box><size>6.280 9.250 0.100</size></box></geometry></collision>
