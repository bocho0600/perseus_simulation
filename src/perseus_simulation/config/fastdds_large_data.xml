<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS transport profile for the MID-360 point cloud.

  /livox/lidar is 720 x 32 points at 32 bytes = 737 KB per message, 10 Hz.
  Fast DDS's default shared-memory segment is far smaller than one message, so
  every cloud fell back to UDPv4 and was fragmented into ~12 datagrams; losing
  any single fragment discards the whole cloud. Measured effect: the gz topic
  published a steady 9.8 Hz while ROS subscribers saw ~5.5 Hz with gaps of over
  a second. The IMU (a few hundred bytes) was unaffected at 197 Hz.

  This declares a shared-memory transport with a segment big enough to carry
  several clouds, and keeps a UDPv4 transport with enlarged socket buffers for
  anything off-host. Needs no root - it is all inside Fast DDS.

  Applied via FASTRTPS_DEFAULT_PROFILES_FILE. pixi.toml exports it for the whole
  environment so external consumers (FAST-LIO, RViz, ros2 topic hz) get the same
  transports; a subscriber without it negotiates UDP again and still drops.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_large</transport_id>
        <type>SHM</type>
        <segment_size>67108864</segment_size>
        <maxMessageSize>4194304</maxMessageSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>udp_large</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>8388608</sendBufferSize>
        <receiveBufferSize>8388608</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="perseus_large_data" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_large</transport_id>
          <transport_id>udp_large</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
